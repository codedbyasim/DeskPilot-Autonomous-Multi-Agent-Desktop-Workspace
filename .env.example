# ==============================================================================
# DeskPilot — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your AWS credentials before running.
# NEVER commit your actual '.env' file containing secrets to GitHub!
# ==============================================================================

# ── 1. AWS Amazon Bedrock Credentials (Choose Option A or Option B) ───────────

# Option A: Direct Amazon Bedrock API Key (Recommended for Quickstart)
# Generate from AWS Bedrock Console -> API Keys
BEDROCK_API_KEY=your_bedrock_api_key_here

# Option B: Standard AWS IAM Access Keys (For Production / Enterprise)
# Requires permissions: bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# ── 2. Bedrock Foundation Model Selection ─────────────────────────────────────
# Default: Amazon Nova Pro (High reasoning speed, multimodality & tool accuracy)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Supported alternatives:
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0

# ── 3. Application & Server Settings ──────────────────────────────────────────
APP_NAME=DeskPilot
APP_VERSION=2.0.0
APP_PORT=5000
APP_HOST=0.0.0.0

# Deliverables Output Directory (Local folder or shared volume)
DEFAULT_OUTPUT_DIR=C:/Users/Public/DeskPilot_Output

# Autonomous Agent Execution Limits
MAX_RESEARCH_SOURCES=5
MAX_RETRY_ATTEMPTS=3
LOG_LEVEL=INFO
